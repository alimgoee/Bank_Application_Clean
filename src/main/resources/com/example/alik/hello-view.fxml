<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Hyperlink?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.alik.controllers.HelloController">
  <children>
    <Label fx:id="errorLoginPasswordText" text="" style="-fx-text-fill: red; -fx-font-size: 14px;"/>

    <Label text="Email:" layoutX="50.0" layoutY="30.0" />
    <TextField fx:id="emailField" layoutX="50.0" layoutY="50.0" prefWidth="180.0" />

    <Label text="Password:" layoutX="50.0" layoutY="90.0" />
    <PasswordField fx:id="passwordField" layoutX="50.0" layoutY="110.0" prefWidth="180.0" />

    <Button text="Login" layoutX="50.0" layoutY="160.0" onAction="#onLoginButtonClick" />
    <Hyperlink text="Register" layoutX="120.0" layoutY="165.0" onAction="#goRegister"  />
  </children>
<!--  <padding>-->
<!--    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>-->
<!--  </padding>-->

<!--  <Label fx:id="welcomeText"/>-->
<!--  <Button text="Hello!" onAction="#onHelloButtonClick"/>-->
</VBox>
