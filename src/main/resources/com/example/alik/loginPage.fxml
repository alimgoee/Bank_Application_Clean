<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.alik.controllers.HelloController"
            prefHeight="500.0" prefWidth="500.0">
    <children>
        <Label text="Email:" layoutX="50.0" layoutY="30.0" />
        <TextField fx:id="emailField" layoutX="50.0" layoutY="50.0" prefWidth="200.0" />

        <Label text="Password:" layoutX="50.0" layoutY="90.0" />
        <PasswordField fx:id="passwordField" layoutX="50.0" layoutY="110.0" prefWidth="200.0" />

        <Button text="Login" layoutX="50.0" layoutY="160.0" onAction="#onLoginButtonClick" />
        <Hyperlink text="Register" layoutX="120.0" layoutY="165.0" onAction="" />
    </children>
</AnchorPane>
