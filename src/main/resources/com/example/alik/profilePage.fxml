<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import com.example.alik.entities.User?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Hyperlink?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.alik.ProfileController"
>

    <children>
        <Label text="Профиль пользователя" layoutX="50.0" layoutY="30.0" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <Label text="Email:" />
        <Label fx:id="emailLabel" layoutX="100" layoutY="200" />



        <Label text="Баланс:" />
        <Label fx:id="balanceLabel" text="" style="-fx-font-size: 14px;"/>
        <Button text="Перевод" layoutX="50.0" layoutY="160.0" onAction="#goPerevod" />
        <Button text="Мой банк" layoutX="150.0" layoutY="160.0" onAction="#goMyBank" />
        <Button text="Магазин" layoutX="250.0" layoutY="160.0" onAction="#goShop" />
    </children>
</VBox>
